#!/bin/sh

# brew
ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"
brew install zsh
brew install wget

# oh my zsh
curl https://raw.github.com/robbyrussell/oh-my-zsh/master/tools/install.sh | sh

#fuzzy finder
git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
~/.fzf/install

#links

ln -sf ~/dotfiles/git/gitconfig     ~/.gitconfig
ln -sf ~/dotfiles/git/gitignore     ~/.gitignore_global

ln -sf ~/dotfiles/hammerspoon     ~/.hammerspoon
ln -sf ~/dotfiles/vimconfig/vimrc   ~/.vimrc
ln -sf ~/dotfiles/vimconfig/vim     ~/.vim
ln -sf ~/dotfiles/vimconfig/xvimrc  ~/.xvimrc
ln -sf ~/dotfiles/nvim/init.vim     ~/.config/nvim/init.vim

mkdir -p ~/.config/herdr
ln -sf ~/dotfiles/herdr/config.toml ~/.config/herdr/config.toml
ln -sfn ~/dotfiles/herdr/scripts    ~/.config/herdr/scripts

# herdr resolves [[keys.command]] entries from PATH, so these are named commands.
mkdir -p ~/.local/bin
ln -sf ~/dotfiles/herdr/scripts/claude-account.sh ~/.local/bin/claude-account
ln -sf ~/dotfiles/herdr/scripts/agent-switch.sh   ~/.local/bin/herdr-agent-switch

ln -sf ~/dotfiles/zsh/zshrc         ~/.zshrc

# vundle
git clone https://github.com/gmarik/Vundle.vim.git ~/.vim/bundle/Vundle.vim

#plug for nvim
curl -fLo ~/.local/share/nvim/site/autoload/plug.vim --create-dirs \
    https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim

# Downloads
wget -O ~/Downloads/iTerm.zip https://iterm2.com/downloads/stable/latest
